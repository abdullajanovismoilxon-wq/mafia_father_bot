apiVersion: v1
kind: Secret
metadata:
  name: mafiabotfather-secrets
  namespace: mafiabotfather
type: Opaque
stringData:
  DJANGO_SECRET_KEY: "change-in-production-to-strong-secret-key"
  DATABASE_URL: "postgres://postgres:password@postgres-service.mafiabotfather.svc.cluster.local:5432/mafiabotfather_db"
  ENCRYPTION_KEY: "change-in-production-to-32-byte-base64-fernet-key="
  JWT_SECRET: "change-in-production-to-strong-jwt-secret"
  STRIPE_SECRET_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
  PAYME_SECRET_KEY: ""
  CLICK_SECRET_KEY: ""
