# ===========================================================================
# MAFIA BOT FATHER — PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================================================

# Security & Secrets
DJANGO_SECRET_KEY=generate-a-strong-random-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=mafiabotfather.uz,api.mafiabotfather.uz,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://mafiabotfather.uz,https://app.mafiabotfather.uz

# Symmetric Fernet Encryption Key for Bot Tokens (32 base64 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key-base64==

# JWT Authentication Secret
JWT_SECRET=replace-with-strong-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# PostgreSQL Database
POSTGRES_DB=mafiabotfather_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgres://postgres:replace-with-strong-db-password@postgres:5432/mafiabotfather_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Payment Gateways (Stripe, Payme, Click)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYME_MERCHANT_ID=replace_payme_merchant_id
PAYME_SECRET_KEY=replace_payme_secret_key
CLICK_SERVICE_ID=replace_click_service_id
CLICK_MERCHANT_ID=replace_click_merchant_id
CLICK_SECRET_KEY=replace_click_secret_key

# Currency & Rates
DEFAULT_USD_TO_UZS_RATE=12800

# Telegram Support & Bot Father
TELEGRAM_SUPPORT_USERNAME=mafiabotfather_support

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost/api/v1
